---
import { url } from '../lib/urls';
interface Props { href: string; class?: string; }
const { href, class: className } = Astro.props;
const external = /^https?:\/\//.test(href);
---
<a href={url(href)} class={className} data-external={external || undefined}><slot />{external && <><span class="external-mark" aria-hidden="true">↗</span><span class="sr-only"> (external link)</span></>}</a>
