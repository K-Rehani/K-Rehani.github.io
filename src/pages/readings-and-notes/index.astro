---
import Base from '../../layouts/Base.astro';
import Link from '../../components/Link.astro';
import profile from '../../data/profile.json';
---
<Base title="Readings & Notes" description="Physics and mathematics notes, readings, and books shared by Kautik Rehani.">
  <header class="page-header"><h1>Readings & Notes</h1></header>
  <section>
    <h2>Readings</h2>
    <ol>
      <li>Griffiths, <em>Introduction to Electrodynamics</em>, Chapter 12: special relativity and electrodynamics</li>
      <li>Vectors and index notation</li>
      <li>Lagrangian formulation of electrodynamics</li>
      <li>Srednicki, <em>Quantum Field Theory</em>, Chapters 1, 2 and 33</li>
      <li>Zee, <em>Quantum Field Theory in a Nutshell</em>, Sections I.1–I.3: path-integral basics</li>
    </ol>
  </section>
  <section>
    <h2>Notes</h2>
    {profile.notesRepository && <p><Link href={profile.notesRepository}>Physics & mathematics notes on GitHub</Link></p>}
  </section>
  <p class="small muted">Any corrections to the notes are welcome</p>
</Base>
