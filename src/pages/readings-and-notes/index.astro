---
import Base from '../../layouts/Base.astro';
import Link from '../../components/Link.astro';
import profile from '../../data/profile.json';
---
<Base title="Readings & Notes" description="Physics and mathematics notes, readings, and books shared by Kautik Rehani.">
  <header class="page-header"><h1>Readings & Notes</h1></header>
  <section id="readings">
    <h2 id="primary-readings">Primary Readings (given by Prof. Sudarshan)</h2>
    <table class="reading-table" aria-labelledby="primary-readings">
      <thead><tr><th scope="col">No.</th><th scope="col">Material</th></tr></thead>
      <tbody>
        <tr><td>1</td><td>Griffiths, <Link href="https://www.cambridge.org/highereducation/books/introduction-to-electrodynamics/3AB220820DBB628E5A43D52C4B011ED4"><em>Introduction to Electrodynamics</em></Link>, Chapter 12: special relativity and electrodynamics</td></tr>
        <tr><td>2</td><td>Vectors and index notation (<Link href="https://github.com/K-Rehani/Physics-Mathematics-Lecture-Notes/blob/main/Readings/Vectors%20and%20Index%20Notation.pdf">PDF</Link>)</td></tr>
        <tr><td>3</td><td>Lagrangian formulation of electrodynamics (<Link href="https://github.com/K-Rehani/Physics-Mathematics-Lecture-Notes/blob/main/Readings/ED%20Lagrange%20Formalism.pdf">PDF</Link>)</td></tr>
        <tr><td>4</td><td>Srednicki, <Link href="https://www.cambridge.org/highereducation/books/quantum-field-theory/718DD037728FB3745F48A40A6D9A8A1C"><em>Quantum Field Theory</em></Link>, Chapters 1, 2 and 33</td></tr>
        <tr><td>5</td><td>Zee, <Link href="https://press.princeton.edu/books/hardcover/9780691140346/quantum-field-theory-in-a-nutshell"><em>Quantum Field Theory in a Nutshell</em></Link>, Sections I.1–I.3: path-integral basics</td></tr>
      </tbody>
    </table>
  </section>
  <section>
    <h2 id="advanced-readings">Advanced Readings (Self)</h2>
    <table class="reading-table" aria-labelledby="advanced-readings">
      <thead><tr><th scope="col">No.</th><th scope="col">Material</th></tr></thead>
      <tbody>
        <tr><td>1</td><td>J. J. Sakurai, <Link href="https://www.cambridge.org/highereducation/books/modern-quantum-mechanics/DF43277E8AEDF83CC12EA62887C277DC"><em>Modern Quantum Mechanics</em></Link></td></tr>
        <tr><td>2</td><td>David Tong, <Link href="https://www.damtp.cam.ac.uk/user/tong/qft.htm"><em>Quantum Field Theory</em></Link></td></tr>
        <tr><td>3</td><td>David Skinner, <Link href="https://www.damtp.cam.ac.uk/user/dbs26/AQFT.html"><em>Advanced Quantum Field Theory</em></Link></td></tr>
        <tr><td>4</td><td>Simon Badger, Johannes Henn, Jan Christoph Plefka and Simone Zoia, <Link href="https://link.springer.com/book/10.1007/978-3-031-46987-9"><em>Scattering Amplitudes in Quantum Field Theory</em></Link></td></tr>
      </tbody>
    </table>
  </section>
  <section>
    <h2 id="notes">Notes</h2>
    {profile.notesRepository && <p><Link href={profile.notesRepository}>Physics & mathematics notes on GitHub</Link></p>}
  </section>
  <p class="small muted">Any corrections to the notes are welcome</p>
</Base>
