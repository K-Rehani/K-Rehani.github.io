---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Link from '../../components/Link.astro';
import NoteEntry from '../../components/NoteEntry.astro';
import profile from '../../data/profile.json';
const notes = (await getCollection('notes', ({data}) => !data.draft)).sort((a,b) => a.data.order - b.data.order);
const subjects = [...new Set(notes.map(n => n.data.subject))];
---
<Base title="Readings & Notes" description="Physics and mathematics notes, readings, and books shared by Kautik Rehani.">
  <header class="page-header"><h1>Readings & Notes</h1></header>
  {profile.notesRepository && <p><Link href={profile.notesRepository}>Physics & mathematics notes on GitHub</Link></p>}
  {subjects.map(subject => <section><h2>{subject}</h2>{notes.filter(n => n.data.subject === subject).map(note => <NoteEntry note={note} />)}</section>)}
  <p>The reading material and references for my work with Prof. Sudarshan Ananth are collected on the <Link href="/research/light-cone-field-theory/">project page</Link>.</p>
  <aside class="quiet-panel"><p>My personal study notes may contain errors. Corrections are welcome.</p></aside>
</Base>
