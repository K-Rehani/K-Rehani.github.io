---
import Base from '../layouts/Base.astro';
import Link from '../components/Link.astro';
import profile from '../data/profile.json';
---
<Base title="Contact" description="Find Kautik Rehani online. Junior students are welcome to get in touch about physics, resources, and starting research.">
  <header class="page-header"><h1>Contact</h1></header>
  <ul class="contact-list">{profile.email && <li><span>Email</span><div class="email-address">
      <Link href={`mailto:${profile.email}`}>{profile.email}</Link>
      <button id="copy-email" class="copy-email" type="button" data-email={profile.email} aria-label="Copy email address" title="Copy email address">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="11" height="11" rx="1.5" />
          <path d="M5 15H4a1.5 1.5 0 0 1-1.5-1.5v-10A1.5 1.5 0 0 1 4 2h10a1.5 1.5 0 0 1 1.5 1.5V5" />
        </svg>
      </button>
      <span id="copy-email-status" class="sr-only" role="status" aria-live="polite"></span>
    </div></li>}<li><span>GitHub</span><Link href={profile.github}>K-Rehani</Link></li>{profile.linkedin && <li><span>LinkedIn</span><Link href={profile.linkedin}>{profile.name}</Link></li>}</ul>
  {!profile.email && <p class="small muted">A public email address will be added here.</p>}
  <section class="quiet-panel">
    <h2>For Collaboration</h2>
    <p>Feel free to contact me about opportunities to collaborate. I am always interested in hearing about new ideas and results in physics and related mathematics. I value open and honest discussions about my research, including feedback and criticism.</p>
  </section>
  <section class="quiet-panel">
    <h2>To junior students</h2>
    <p>{profile.juniorNote} If you want to understand my work, I would first recommend <Link href="/readings-and-notes/#readings">a few readings</Link> after which we can have a more fruitful discussion. I have also put the link to my <Link href="/readings-and-notes/#notes">notes</Link> on GitHub for several courses along with recommended books that helped me.</p>
  </section>
</Base>
