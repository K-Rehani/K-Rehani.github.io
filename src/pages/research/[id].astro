---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Link from '../../components/Link.astro';
import ResourceLinks from '../../components/ResourceLinks.astro';
export async function getStaticPaths() { return (await getCollection('research', ({data}) => !data.draft)).map(project => ({ params: { id: project.id }, props: { project } })); }
const { project } = Astro.props;
const { Content } = await render(project);
const p = project.data;
---
<Base title={p.title} description={p.summary} math>
  <Link class="back-link" href="/research/">← Research</Link>
  <header class="page-header"><p class="eyebrow">{p.category}</p><h1>{p.title}</h1><p class="detail-meta">{p.dates} · {p.institution}<br />{p.supervisor && (p.supervisorUrl ? <Link href={p.supervisorUrl}>{p.supervisor}</Link> : p.supervisor)}</p><ResourceLinks resources={p.resources} /></header>
  <div class="prose"><Content /></div><ul class="interests detail-topics">{p.topics.map(t => <li>{t}</li>)}</ul>
</Base>
