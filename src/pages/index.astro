---
import Base from '../layouts/Base.astro';
import profile from '../data/profile.json';
import { Content as Bio } from '../content/pages/home.md';
import { url } from '../lib/urls';
---
<Base math>
  <h1 class="sr-only">{profile.name}</h1>
  <section class="home-introduction" aria-label="Introduction">
    {profile.photo && <img class="portrait" src={url(profile.photo)} alt={profile.photoAlt} width="240" height="300" />}
    <div class="intro prose"><Bio /></div>
  </section>
  <p slot="footer-note" class="site-credit">This website was created with assistance from ChatGPT.</p>
</Base>
